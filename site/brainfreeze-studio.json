{
  "schema": "brainfreeze-studio-setup/1",
  "product": "brainfreeze studio",
  "site": "https://kody-w.github.io/rapp-brainfreeze-studio/",
  "repository": "https://github.com/kody-w/rapp-brainfreeze-studio",
  "skill": "https://kody-w.github.io/rapp-brainfreeze-studio/skills/brainfreeze-studio/SKILL.md",
  "claude_code": "https://kody-w.github.io/rapp-brainfreeze-studio/CLAUDE.md",
  "llms": "https://kody-w.github.io/rapp-brainfreeze-studio/llms.txt",
  "golden_path": "github-copilot",
  "compatibility": [
    "claude-code",
    "any AI agent that can run commands"
  ],
  "requirements": {
    "python": ">=3.9",
    "git": "any",
    "azure_cli": "for the person's own sign-in (az login)",
    "node_and_npm": "only for a Power Apps code app"
  },
  "work_folder": "~/brainfreeze-work",
  "setup": [
    "git clone https://github.com/kody-w/rapp-brainfreeze-studio.git",
    "python3 -m venv .venv"
  ],
  "runner": {
    "bfs": "../.venv/bin/python -m brainfreeze_studio",
    "bfs_windows": "..\\.venv\\Scripts\\python.exe -m brainfreeze_studio",
    "cwd": "~/brainfreeze-work/rapp-brainfreeze-studio"
  },
  "sign_in": {
    "person_runs": "az login --allow-no-subscriptions",
    "other_tenant": "add --tenant <their tenant domain>",
    "separate_profile": "AZURE_CONFIG_DIR=~/.azure-brainfreeze",
    "list_environments": "bfs environments"
  },
  "sources": {
    "brainstem": {
      "tools": [
        "../.venv/bin/python -m pip install git+https://github.com/kody-w/rapp-brainfreeze.git",
        "git -C .. clone https://github.com/kody-w/copilot-harness-sdk.git"
      ],
      "freeze": "../.venv/bin/python -m brainfreeze egg ~/.brainstem/src/rapp_brainstem --owner <github-login> --slug <short-name> --no-memory --out ../eggs",
      "build": "bfs build ../eggs/<github-login>--<short-name>.egg --name \"<Agent name>\" --publisher-prefix rapp --sdk-dir ../copilot-harness-sdk --translations translations/ --environment <environment> --out ../build/<short-name>",
      "deploy": "bfs deploy ../build/<short-name>/workspace --environment <environment> --draft"
    },
    "rapp_store_app": {
      "catalog": "https://kody-w.github.io/RAPP_Store/",
      "build": "bfs rapplication <@publisher/id> --translations translations/ --out ../build/<id>",
      "deploy": "bfs rapplication <@publisher/id> --translations translations/ --out ../build/<id> --environment <environment> --deploy --draft --no-app"
    },
    "sample": {
      "build": "bfs rapplication examples/rapplications/invoice_router --translations translations/ --out ../build/invoice-router",
      "deploy": "bfs rapplication examples/rapplications/invoice_router --translations translations/ --out ../build/invoice-router --environment <environment> --deploy --draft --no-app",
      "parity": "parity:       InvoiceRouter 72/72 PROVEN",
      "question": "Route an invoice from Fabrikam for $18,750.",
      "check": "expand the agent's Route an invoice step: its Output is exactly the answer below",
      "answer": "Fabrikam $18,750.00: queue APPROVAL, needs AP manager sign-off (limit $10,000)."
    }
  },
  "verify": [
    "the build's parity lines: each translated agent matches its Python on every test case, or is refused",
    "the deploy's read-back: every component is on the live record, and it is the harness agent that was built",
    "a real reply in Copilot Studio's test chat, opened from the deploy's maker: link"
  ],
  "consent": {
    "before_install": "say what you will set up and where, and wait for yes",
    "before_deploy": "say what you will create in which environment, and wait for yes",
    "publish": "only when the person asks: the same deploy without --draft"
  },
  "never": [
    "publish without the person asking",
    "deploy to an environment the person did not pick",
    "use a service account, a client secret or an app-only token",
    "delete agents, flows, connections or data, or change environment settings",
    "print, paste or save a token"
  ]
}
